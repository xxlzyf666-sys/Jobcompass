# Copy to .env for local use. The binary accepts --env-file .env.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
DATA_DIR=./data

# Both fields are required for real diagnosis; missing values enable example-only preview.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
PROVIDER_NAME=Anthropic Claude
DATA_REGION=日本

# Required in production: generate with `openssl rand -hex 32`.
# Development creates a private key file in DATA_DIR if omitted.
DATA_ENCRYPTION_KEY=
WORKER_COUNT=2
QUEUE_LIMIT=20
DIAGNOSES_PER_IP_HOUR=3
DIAGNOSES_PER_SESSION_DAY=5
RETENTION_HOURS=168
REQUEST_TIMEOUT_SECONDS=120
